mutate(
X = case_when(
region == "Western Norway" ~ X - 180000,  # Reverted to previous placement
region == "Central Norway" ~ X - 220000,  # Maintained leftward shift
region == "Northern Norway" ~ X - 180000,
TRUE ~ X
),
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# Extract base coordinates for national inlay
