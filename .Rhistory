label_coords <- regnor %>%
st_point_on_surface() %>%
st_coordinates() %>%
as.data.frame()
# 2. Attach coordinates to the attribute data frame
label_data <- regnor %>%
st_drop_geometry() %>%
bind_cols(label_coords)
# 3. Apply individual, custom meter nudges for each region
label_data <- label_data %>%
mutate(
X = case_when(
region == "Western Norway" ~ X - 90000,   # Shorter shift so it stays on screen
region == "Central Norway" ~ X - 220000,  # Pushed further left as requested
region == "Northern Norway" ~ X - 180000, # Kept at previous stable distance
TRUE ~ X                                  # Leaves other regions at center
),
# Right-align the text elements that are shifted to the left of the landmass
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# 4. Extract base coordinates from the raw surface extraction
central_x_base  <- label_coords$X[regnor$region == "Central Norway"]
northern_y_base <- label_coords$Y[regnor$region == "Northern Norway"]
# 5. Position the National inlay further down and right
inlay_x <- central_x_base + 240000  # Pushed further right (was 150000)
inlay_y <- northern_y_base - 350000 # Pushed further down (was 220000)
ggplot() +
# 1. Plot the base light beige map with black borders
geom_sf(data = regnor, fill = "#F5F5DC", color = "black", size = 0.5) +
# 2. Add the custom shifted region labels
geom_text(
data = label_data,
aes(x = X, y = Y, label = map_label, hjust = hjust_val),
