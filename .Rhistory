theme_minimal() +
labs(
title = "Regional Indicator Values and Sample Sizes",
x = NULL, y = NULL
)
# Extract and calculate the national back-transformed intercept value
nat_val <- round(plogis(summary(nitrogen.no)$coef$cond[1, 1]), 2)
# Extract the total number of observations
nat_n <- summary(nitrogen.no)$nobs
# Create the text string for your bottom-right inlay
inlay_text <- paste0("National\nVal: ", nat_val, "\nN = ", nat_n)
ggplot(data = regnor) +
# 1. Color all regions a static light beige with a distinct black border
geom_sf(fill = "#F5F5DC", color = "black", size = 0.5) +
# 2. Add the centered regional labels (from the previous step)
geom_sf_text(
aes(label = map_label),
size = 3.5,
color = "black",
fontface = "bold",
fun.geometry = sf::st_centroid
) +
# 3. Add the National summary text inlay in the bottom right corner
# Adjust x and y if your specific map coordinate range requires fine-tuning
annotate(
"text",
x = Inf, y = -Inf,       # Coordinates set to absolute bottom-right
label = inlay_text,
hjust = 1.1, vjust = -0.5, # Slightly offsets text away from the absolute edge
size = 4,
fontface = "italic",
color = "black"
) +
# 4. Completely remove coordinates, background lines, ticks, and legends
theme_void() +
theme(
legend.position = "none" # Forces any leftover legends to hide
)
regnor
# 1. Extract the true spatial centers of each region
label_coords <- regnor %>%
st_point_on_surface() %>%
st_coordinates() %>%
as.data.frame()
# 2. Bind coordinates to metadata to make adjustments easy
label_data <- regnor %>%
st_drop_geometry() %>%
bind_cols(label_coords)
# 3. Apply custom layout nudges (adjust shifts depending on your map units / CRS)
# If your CRS is in meters (like UTM), shift by ~80000. If degrees (WGS84), shift by ~1.5.
nudge_value <- if(st_is_longlat(regnor)) 1.5 else 80000
label_data <- label_data %>%
mutate(
# Shift specified regions to the left
X = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
X - nudge_value, X),
# Shift horizontal text alignment so left-shifted labels read cleanly
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# 4. Programmatically position the National inlay
# "Right of Central Norway (X)" and "Below Northern Norway (Y)"
central_x   <- label_data$X[label_data$region == "Central Norway"]
northern_y  <- label_data$Y[label_data$region == "Northern Norway"]
# Shift slightly right of Central Norway's un-nudged position to look balanced
inlay_x <- central_x + (nudge_value * 2)
inlay_y <- northern_y - (nudge_value * 1.5)
ggplot() +
# 1. Plot the base light beige map with black borders
geom_sf(data = regnor, fill = "#F5F5DC", color = "black", size = 0.5) +
# 2. Add the custom positioned region labels
geom_text(
data = label_data,
aes(x = X, y = Y, label = map_label, hjust = hjust_val),
size = 3.5,
color = "black",
fontface = "bold",
lineheight = 0.9
) +
# 3. Add the National inlay exactly where requested
annotate(
"text",
x = inlay_x, y = inlay_y,
label = inlay_text,
size = 4,
fontface = "italic",
color = "black",
hjust = 0,         # Left-aligned relative to its coordinate point
lineheight = 0.9
) +
# 4. Minimalist visual settings
theme_void() +
theme(legend.position = "none")
label_coords <- regnor %>%
st_point_on_surface() %>%
st_coordinates() %>%
as.data.frame()
# 2. Attach coordinates to the attribute data frame
label_data <- regnor %>%
st_drop_geometry() %>%
bind_cols(label_coords)
# 3. Define shifting distances in meters
left_nudge    <- 180000  # Moves Western, Central, and Northern labels 180km left
inlay_right   <- 150000  # Moves National inlay 150km right of Central Norway
inlay_down    <- 220000  # Moves National inlay 220km down from Northern Norway
label_data <- label_data %>%
mutate(
# Shift specified labels to the left into the sea
X = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
X - left_nudge, X),
# Right-align text that goes to the left of the map so it fits elegantly
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# 4. Extract anchors for the custom position of your National inlay
# We use the raw, unshifted coordinates of the regions to position the inlay cleanly
central_x_base  <- label_coords$X[regnor$region == "Central Norway"]
northern_y_base <- label_coords$Y[regnor$region == "Northern Norway"]
# Compute final coordinates for the national label text
inlay_x <- central_x_base + inlay_right
inlay_y <- northern_y_base - inlay_down
ggplot() +
# 1. Plot the base light beige map with black borders
geom_sf(data = regnor, fill = "#F5F5DC", color = "black", size = 0.5) +
# 2. Add the custom shifted region labels
geom_text(
data = label_data,
aes(x = X, y = Y, label = map_label, hjust = hjust_val),
size = 3.5,
color = "black",
fontface = "bold",
lineheight = 0.9
) +
# 3. Add the National inlay exactly where requested
annotate(
"text",
x = inlay_x, y = inlay_y,
label = inlay_text,
size = 4,
fontface = "italic",
color = "black",
hjust = 0, # Left-aligned starting from its custom point
lineheight = 0.9
) +
# 4. Strip out map coordinate grids and legends completely
theme_void() +
theme(legend.position = "none")
