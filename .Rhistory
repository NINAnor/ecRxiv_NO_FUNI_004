# 1. Extract true inside coordinates (UTM 33N meters)
label_coords <- regnor %>%
st_point_on_surface() %>%
st_coordinates() %>%
as.data.frame()
# 2. Attach coordinates to the attribute data frame
label_data <- regnor %>%
st_drop_geometry() %>%
bind_cols(label_coords)
# 3. Revert Western Norway to its previous stable placement (-180km)
label_data <- label_data %>%
mutate(
X = case_when(
region == "Western Norway" ~ X - 180000,  # Reverted to previous placement
region == "Central Norway" ~ X - 220000,  # Maintained leftward shift
region == "Northern Norway" ~ X - 180000,
TRUE ~ X
),
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# 4. Extract base coordinates for national inlay
central_x_base  <- label_coords$X[regnor$region == "Central Norway"]
northern_y_base <- label_coords$Y[regnor$region == "Northern Norway"]
# 5. National Inlay Position (maintained further down and right)
inlay_x <- central_x_base + 240000
inlay_y <- northern_y_base - 350000
# Get the bounding box limits of your original dataset
bbox <- st_bbox(regnor)
# Extend the left boundary (xmin) out by an extra 250,000 meters
# to give the shifted western text plenty of breathing room.
extended_xmin <- bbox[["xmin"]] - 250000
extended_xmax <- bbox[["xmax"]] + 100000 # minor padding on the right side for the inlay
ggplot() +
# 1. Plot the base light beige map with black borders
geom_sf(data = regnor, fill = "#F5F5DC", color = "black", size = 0.5) +
# 2. Add the custom fine-tuned region labels
geom_text(
data = label_data,
aes(x = X, y = Y, label = map_label, hjust = hjust_val),
size = 3.5,
color = "black",
fontface = "bold",
lineheight = 0.9
) +
# 3. Add the repositioned National inlay
annotate(
"text",
x = inlay_x, y = inlay_y,
label = inlay_text,
size = 4,
fontface = "italic",
color = "black",
hjust = 0,
lineheight = 0.9
) +
# 4. Enforce the expanded canvas limits explicitly
coord_sf(
xlim = c(extended_xmin, extended_xmax),
ylim = c(bbox[["ymin"]], bbox[["ymax"]]),
clip = "off"
) +
# 5. Clean, minimalist formatting
theme_void() +
theme(
legend.position = "none"
)
