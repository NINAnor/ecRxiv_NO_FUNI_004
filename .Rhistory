# We use \n to push the N count to a new line so it looks clean inside the polygon
regnor$map_label <- paste0(
"Val: ", round(regnor$indicator_value, 2), "\n",
"N = ", regnor$N
)
# Extract and calculate the national back-transformed intercept value
nat_val <- round(plogis(summary(nitrogen.no)$coef$cond[1, 1]), 2)
# Extract the total number of observations
