fontface = "italic",
color = "black",
hjust = 0, # Left-aligned starting from its custom point
lineheight = 0.9
) +
# 4. Strip out map coordinate grids and legends completely
theme_void() +
theme(legend.position = "none")
label_coords <- regnor %>%
st_point_on_surface() %>%
st_coordinates() %>%
as.data.frame()
# 2. Attach coordinates to the attribute data frame
label_data <- regnor %>%
st_drop_geometry() %>%
bind_cols(label_coords)
# 3. Revert Western Norway to its previous stable placement (-180km)
label_data <- label_data %>%
mutate(
X = case_when(
region == "Western Norway" ~ X - 180000,  # Reverted to previous placement
region == "Central Norway" ~ X - 220000,  # Maintained leftward shift
region == "Northern Norway" ~ X - 180000,
TRUE ~ X
),
hjust_val = ifelse(region %in% c("Western Norway", "Central Norway", "Northern Norway"),
1, 0.5)
)
# 4. Extract base coordinates for national inlay
central_x_base  <- label_coords$X[regnor$region == "Central Norway"]
northern_y_base <- label_coords$Y[regnor$region == "Northern Norway"]
# 5. National Inlay Position (maintained further down and right)
inlay_x <- central_x_base + 240000
inlay_y <- northern_y_base - 350000
